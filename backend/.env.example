# ------------------------------------------------------------------
# Summarix — Backend environment variables (TEMPLATE / EXAMPLE)
# Copy this file to `.env` and fill in real values for local dev.
# ------------------------------------------------------------------

# Public URL of the deployed frontend (CORS allow-list origin).
# When running locally via `npm run dev` the default Vite port is 5173.
# Docker-compose sets this automatically; you only need it for `uvicorn` runs.
FRONTEND_ORIGIN=http://localhost:5173

# Optional: override HuggingFace cache location. Defaults to ~/.cache/huggingface.
# TRANSFORMERS_CACHE=./.cache/huggingface
# HF_HOME=./.cache/huggingface

# Optional: API / service keys if you front the backend with e.g. Render secrets.
# (none required for the default Summarix setup — models run locally)
# API_KEY=
