# ------------------------------------------------------------------
# Summarix — Frontend environment variables (TEMPLATE / EXAMPLE)
#
# Vite embeds `import.meta.env.VITE_*` into the static bundle at BUILD
# time, so set these before `npm run build` / deploying to Vercel etc.
# Copy this file to `.env` / `.env.development` / `.env.production`
# ------------------------------------------------------------------

# Base URL of the Summarix FastAPI backend (no trailing slash!).
#   Local dev:     http://localhost:8000
#   Docker:        http://localhost:8000  (docker-compose default)
#   Deployed (e.g. Render / Railway):  https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
